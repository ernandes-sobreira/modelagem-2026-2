function pareado(){
  const dReal=parseInt(document.getElementById('pdif').value)/10;
  const varPontos=parseInt(document.getElementById('pvar').value);
  const antes=[],depois=[];
  for(let i=0;i<10;i++){
    const base=normalR(50,varPontos);
    antes.push(base+normalR(0,1.2));
    depois.push(base+dReal+normalR(0,1.2));
  }
  let linhas='';
  for(let i=0;i<10;i++){
    linhas+='<tr><th class="lin">'+(i+2)+'</th><td class="n">'+(i+1)+'</td>'+
      '<td class="n">'+antes[i].toFixed(2)+'</td><td class="n">'+depois[i].toFixed(2)+'</td>'+
      '<td class="n">'+(depois[i]-antes[i]).toFixed(2)+'</td></tr>';
  }
  document.getElementById('tabelaPar').innerHTML=
    '<div class="xl"><div class="xl-bar"><span class="xl-ref">D2</span><span class="xl-fx">fx</span>'+
    '<span class="xl-form">=C2-B2</span></div>'+
    '<div class="xl-rolar"><table class="xl-grid">'+
    '<tr><th class="col"></th><th class="col">A</th><th class="col">B</th><th class="col">C</th><th class="col">D</th></tr>'+
    '<tr><th class="lin">1</th><td class="cab">ponto</td><td class="cab">antes</td><td class="cab">depois</td><td class="cab">diferenca</td></tr>'+
    linhas+'</table></div></div>'+
    '<p class="xl-nota">A coluna D é o que o teste pareado analisa. Repare como ela varia pouco, mesmo com as colunas B e C variando muito.</p>';
  const nA=10;
  const vA=varAm(antes),vB=varAm(depois);
  const sp2=((nA-1)*vA+(nA-1)*vB)/(2*nA-2);
  const tI=(media(depois)-media(antes))/Math.sqrt(sp2*(2/nA));
  const pI=pT(tI,2*nA-2);
  const difs=antes.map(function(a,i){return depois[i]-a;});
  const tP=media(difs)/(dpAm(difs)/Math.sqrt(nA));
  const pP=pT(tP,nA-1);
  document.getElementById('tInd').textContent=tI.toFixed(2);
  document.getElementById('pInd').textContent=pI<0.001?'<0,001':pI.toFixed(4).replace('.',',');
  document.getElementById('tPar').textContent=tP.toFixed(2);
  document.getElementById('pPar').textContent=pP<0.001?'<0,001':pP.toFixed(4).replace('.',',');
  const fb=document.getElementById('fbPar');
  fb.className='feedback ok';
  let m='<strong>Mesmos dados, dois resultados.</strong> Tratando as colunas como independentes, o t deu '+tI.toFixed(2)+
    ' e o p '+fmtP(pI)+'. Tratando corretamente como pareado, o t deu '+tP.toFixed(2)+' e o p '+fmtP(pP)+'. ';
  if(pI>0.05&&pP<0.05)m+='<br><br><strong>Repare no que aconteceu.</strong> O teste independente não detectou nada e o pareado detectou. O motivo está na coluna D da planilha: os pontos de coleta são muito diferentes entre si, e essa variação enorme entra no denominador do teste independente e afoga o sinal. No pareado, cada ponto é comparado consigo mesmo, a variação entre pontos desaparece da conta e sobra apenas o efeito. Ignorar o pareamento aqui teria custado a descoberta.';
  else m+='<br><br>Aumente a variação entre pontos de coleta e reduza a diferença real. O contraste entre os dois testes fica mais dramático quando os pontos são muito diferentes entre si e o efeito é pequeno, que é justamente a situação comum em monitoramento ambiental.';
  fb.innerHTML=m;
}
pareado();

function qui(){
  const o=[[0,0,0],[0,0,0]];
  for(let i=0;i<2;i++)for(let j=0;j<3;j++)
    o[i][j]=parseFloat(document.getElementById('c'+i+j).value)||0;
  const totL=o.map(function(l){return l.reduce(function(a,b){return a+b;},0);});
  const totC=[0,1,2].map(function(j){return o[0][j]+o[1][j];});
  const N=totL[0]+totL[1];
  if(N===0)return;
  const e=[[0,0,0],[0,0,0]];
  let x2=0,minE=Infinity;
  for(let i=0;i<2;i++)for(let j=0;j<3;j++){
    e[i][j]=totL[i]*totC[j]/N;
    if(e[i][j]<minE)minE=e[i][j];
    if(e[i][j]>0)x2+=Math.pow(o[i][j]-e[i][j],2)/e[i][j];
  }
  const gl=2;
  const p=pQui(x2,gl);
  document.getElementById('qX').textContent=x2.toFixed(2);
  document.getElementById('qGl').textContent=gl;
  document.getElementById('qP').textContent=p<0.001?'<0,001':p.toFixed(4).replace('.',',');
  document.getElementById('qMin').textContent=minE.toFixed(1);
  let linhas='';
  ['Trincado','Íntegro'].forEach(function(r,i){
    linhas+='<tr><td><strong>'+r+'</strong></td>';
    for(let j=0;j<3;j++){
      const contrib=e[i][j]>0?Math.pow(o[i][j]-e[i][j],2)/e[i][j]:0;
      linhas+='<td class="num">'+o[i][j]+' observado<br>'+e[i][j].toFixed(1)+' esperado<br>'+
        '<span style="color:'+(contrib>2?'#c62828':'#5a6472')+';font-weight:'+(contrib>2?'700':'400')+'">'+
        'contribui '+contrib.toFixed(2)+'</span></td>';
    }
    linhas+='</tr>';
  });
  document.getElementById('tabelaEsp').innerHTML=
    '<div class="tabela-rolar"><table>'+
    '<tr><th></th><th>Granja A</th><th>Granja B</th><th>Granja C</th></tr>'+linhas+'</table></div>';
  const fb=document.getElementById('fbQui');
  let m='';
  if(minE<5)m+='<strong>Restrição violada.</strong> A menor frequência esperada é '+minE.toFixed(1)+
    ', abaixo de 5. Repare que a exigência é sobre a frequência esperada, e não sobre a observada, e é aí que muita gente se confunde. Nessa situação o valor de p não é confiável. Agrupe categorias ou use o teste exato de Fisher, no PAST 4. ';
  else m+='<strong>Restrição atendida.</strong> A menor frequência esperada é '+minE.toFixed(1)+
    ', acima de 5, então o qui-quadrado é aplicável. ';
  m+='<br><br>Com qui-quadrado igual a '+x2.toFixed(2)+' e '+gl+' graus de liberdade, o valor de p é '+fmtP(p)+'. ';
  m+=p<0.05?'Há evidência de associação entre a granja e a proporção de ovos trincados. Olhe as caselas destacadas em vermelho: são as que mais contribuíram para o resultado, e é sobre elas que a discussão deve falar.'
    :'Não há evidência de associação entre a granja e a proporção de ovos trincados. Lembre que isso não prova independência, apenas que os dados não foram surpreendentes o bastante.';
  fb.innerHTML=m;
  fb.className=minE<5?'feedback nao':(p<0.05?'feedback ok':'feedback nao');
}
qui();

