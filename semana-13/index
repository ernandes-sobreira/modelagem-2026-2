    (idx<4?'. Depois: '+blocos[idx+1].n:'. Último bloco');
  let b='';
  blocos.forEach(function(x,i){
    b+='<div class="'+(i<idx?'feito':(i===idx?'atual':''))+'"></div>';
  });
  document.getElementById('cBarras').innerHTML=b;
  const fb=document.getElementById('fbCrono');
  if(restante<0&&!estourou){
    estourou=true;
    fb.className='feedback nao';
    fb.innerHTML='<strong>Bloco estourado.</strong> O tempo de '+blocos[idx].n.toLowerCase()+
