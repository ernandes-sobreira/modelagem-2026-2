<script>
function normal(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function media(a){return a.reduce((x,y)=>x+y,0)/a.length;}
function dpAmostra(a){const m=media(a);return Math.sqrt(a.reduce((x,y)=>x+(y-m)**2,0)/(a.length-1));}

/* ---------- ATIVIDADE 1 ---------- */
document.getElementById('nclasses').addEventListener('input',e=>{
  document.getElementById('ncLabel').textContent=e.target.value;
  if(document.getElementById('dadosFreq').value.trim()!=='')montarFreq();});
function exemploFreq(){
  document.getElementById('dadosFreq').value=
    '9,2\n11,4\n13,1\n14,8\n16,3\n12,7\n10,9\n13,6\n12,2\n11,8\n14,1\n13,9\n9,8\n15,2\n12,5\n13,3\n11,1\n14,5\n12,9\n10,4';
  montarFreq();
}
function montarFreq(){
  const bruto=document.getElementById('dadosFreq').value;
  const v=bruto.split(/[\n,;\t ]+/).map(s=>s.trim().replace(',','.'))
    .filter(s=>s!=='').map(Number).filter(x=>!isNaN(x));
  const alvo=document.getElementById('saidaFreq');
  if(v.length<5){alvo.innerHTML='<div class="feedback nao">Cole pelo menos cinco valores numéricos.</div>';return;}
  const nc=parseInt(document.getElementById('nclasses').value);
  const min=Math.min(...v),max=Math.max(...v);
  const larg=(max-min)/nc||1;
  const bins=new Array(nc).fill(0);
  v.forEach(x=>{let i=Math.floor((x-min)/larg);if(i>=nc)i=nc-1;if(i<0)i=0;bins[i]++;});
  let acum=0,linhas='';
  bins.forEach((c,i)=>{
    acum+=c;
    linhas+=`<tr><td>${(min+i*larg).toFixed(2)} a ${(min+(i+1)*larg).toFixed(2)}</td>
      <td class="num">${c}</td><td class="num">${(c/v.length).toFixed(3)}</td><td class="num">${acum}</td></tr>`;
  });
  const m=media(v),dp=dpAmostra(v);
  const ord=[...v].sort((a,b)=>a-b);
  const mediana=v.length%2?ord[(v.length-1)/2]:(ord[v.length/2-1]+ord[v.length/2])/2;
  const sugerido=Math.round(Math.sqrt(v.length));
  alvo.innerHTML=`
    <div class="saida">
      <div class="metrica"><div class="rot">n</div><div class="val">${v.length}</div></div>
      <div class="metrica"><div class="rot">Média</div><div class="val">${m.toFixed(2)}</div></div>
      <div class="metrica"><div class="rot">Mediana</div><div class="val">${mediana.toFixed(2)}</div></div>
      <div class="metrica"><div class="rot">Desvio padrão</div><div class="val">${dp.toFixed(2)}</div></div>
    </div>
    <div class="tabela-rolar"><table>
      <tr><th>Classe</th><th class="num">Frequência absoluta</th><th class="num">Frequência relativa</th><th class="num">Frequência acumulada</th></tr>
      ${linhas}
    </table></div>
    <canvas id="grafFreq" width="820" height="300"></canvas>
    <div class="legenda-grafico"><span><i style="background:#c2185b"></i> Frequência absoluta por classe</span></div>
    <div class="feedback ok">
      <strong>Leitura.</strong> Com ${v.length} observações, um ponto de partida razoável para o número de classes é ${sugerido}, próximo da raiz quadrada de n. Você está usando ${nc}. Mova o controle e observe: se a forma do histograma muda muito entre ${Math.max(3,sugerido-2)} e ${sugerido+2} classes, desconfie de qualquer interpretação sobre picos e vales.
      ${Math.abs(m-mediana)>0.4*dp?' Além disso, média e mediana estão distantes uma da outra, o que sugere assimetria e cauda para um dos lados.':' Média e mediana estão próximas, o que sugere distribuição razoavelmente simétrica.'}
    </div>`;
  histograma('grafFreq',bins,min,larg,'#c2185b','Valor observado');
}
function histograma(id,bins,min,larg,cor,rotulo){
  const cv=document.getElementById(id),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=52,mD=26,mT=22,mB=50;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const nb=bins.length,maxB=Math.max(...bins,1);
  const x=i=>mE+(i/nb)*(W-mE-mD);
  const y=c=>H-mB-(c/maxB)*(H-mT-mB);
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  bins.forEach((c,i)=>{if(!c)return;
    ctx.fillStyle=cor;ctx.fillRect(x(i)+1,y(c),x(i+1)-x(i)-2,H-mB-y(c));});
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='13px sans-serif';ctx.textAlign='right';
  for(let i=0;i<=4;i++){ctx.fillText(Math.round(maxB*(1-i/4)),mE-8,mT+i*(H-mT-mB)/4+4);}
  ctx.textAlign='center';
  const passo=Math.max(1,Math.ceil(nb/6));
  for(let i=0;i<=nb;i+=passo)ctx.fillText((min+i*larg).toFixed(1),x(i),H-mB+22);
  ctx.font='13.5px sans-serif';ctx.fillText(rotulo,(mE+W-mD)/2,H-12);
}

/* ---------- ATIVIDADE 2 ---------- */
document.getElementById('nN').addEventListener('input',e=>{
  document.getElementById('nNlabel').textContent=e.target.value;});
function regra689599(){
  const mu=parseFloat(document.getElementById('nMedia').value);
  const sd=parseFloat(document.getElementById('nDp').value);
  const n=parseInt(document.getElementById('nN').value);
  const v=[];for(let i=0;i<n;i++)v.push(normal(mu,sd));
  const d1=v.filter(x=>Math.abs(x-mu)<=sd).length;
  const d2=v.filter(x=>Math.abs(x-mu)<=2*sd).length;
  const d3=v.filter(x=>Math.abs(x-mu)<=3*sd).length;
  document.getElementById('f1').textContent=(d1/n*100).toFixed(1)+'%';
  document.getElementById('f2').textContent=(d2/n*100).toFixed(1)+'%';
  document.getElementById('f3').textContent=(d3/n*100).toFixed(1)+'%';
  document.getElementById('f4').textContent=(n-d3);
  const cv=document.getElementById('grafNormal'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=52,mD=26,mT=22,mB=50;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const lo=mu-4*sd,hi=mu+4*sd,nb=40,larg=(hi-lo)/nb;
  const bins=new Array(nb).fill(0);
  v.forEach(x=>{let i=Math.floor((x-lo)/larg);if(i>=0&&i<nb)bins[i]++;});
  const maxB=Math.max(...bins,1);
  const px=val=>mE+((val-lo)/(hi-lo))*(W-mE-mD);
  const py=c=>H-mB-(c/maxB)*(H-mT-mB);
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  bins.forEach((c,i)=>{
    if(!c)return;
    const centro=lo+(i+0.5)*larg,d=Math.abs(centro-mu)/sd;
    ctx.fillStyle=d<=1?'#c2185b':(d<=2?'#f06292':'#f8bbd0');
    ctx.fillRect(px(lo+i*larg)+1,py(c),px(lo+(i+1)*larg)-px(lo+i*larg)-2,H-mB-py(c));
  });
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='13px sans-serif';ctx.textAlign='center';
  [-3,-2,-1,0,1,2,3].forEach(k=>ctx.fillText((mu+k*sd).toFixed(0),px(mu+k*sd),H-mB+22));
