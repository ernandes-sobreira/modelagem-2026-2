function rodarAnova(){
  const nomes=[],grupos=[];
  ['1','2','3','4'].forEach(function(k){
    const v=lerCaixa('g'+k);
    if(v.length>=2){grupos.push(v);nomes.push(document.getElementById('g'+k+'n').value||('grupo '+k));}
  });
  const alvo=document.getElementById('saidaAnova');
  if(grupos.length<2){
    alvo.innerHTML='<div class="feedback nao">Preencha pelo menos dois grupos, com dois valores ou mais em cada.</div>';return;}
  const k=grupos.length;
  const todos=grupos.flat(),N=todos.length,mg=media(todos);
  let sqE=0,sqD=0;
  const medias=[],ns=[];
  grupos.forEach(function(g){
    const m=media(g);medias.push(m);ns.push(g.length);
    sqE+=g.length*(m-mg)*(m-mg);
    g.forEach(function(v){sqD+=(v-m)*(v-m);});
  });
  const sqT=sqE+sqD;
  const glE=k-1,glD=N-k;
  const qmE=sqE/glE,qmD=sqD/glD;
  const F=qmE/qmD,p=pF(F,glE,glD);
  const eta=sqE/sqT;
  let linhasM='';
  medias.forEach(function(m,i){
    linhasM+='<tr><td>'+nomes[i]+'</td><td class="num">'+ns[i]+'</td><td class="num">'+m.toFixed(2)+
      '</td><td class="num">'+Math.sqrt(varAm(grupos[i])).toFixed(2)+'</td></tr>';
  });
  /* comparacoes par a par */
  const nComp=k*(k-1)/2;
  const tc05=tCriticoAlfa(glD,0.05);
  const tcBon=tCriticoAlfa(glD,0.05/nComp);
  let linhasC='';
  for(let i=0;i<k;i++)for(let j=i+1;j<k;j++){
    const dif=Math.abs(medias[i]-medias[j]);
    const se=Math.sqrt(qmD*(1/ns[i]+1/ns[j]));
    const t=dif/se,pp=pT(t,glD);
    const lsd=tc05*se,bon=tcBon*se;
    linhasC+='<tr><td>'+nomes[i]+' contra '+nomes[j]+'</td><td class="num">'+dif.toFixed(2)+
      '</td><td class="num">'+lsd.toFixed(2)+'</td><td class="'+(dif>lsd?'cel-ok':'cel-erro')+'">'+
      (dif>lsd?'difere':'não difere')+'</td><td class="num">'+bon.toFixed(2)+
      '</td><td class="'+(dif>bon?'cel-ok':'cel-erro')+'">'+(dif>bon?'difere':'não difere')+
      '</td><td class="num">'+(pp<0.001?'<0,001':pp.toFixed(4).replace('.',','))+'</td></tr>';
  }
  alvo.innerHTML=
    '<div class="tabela-rolar"><table><tr><th>Grupo</th><th class="num">n</th><th class="num">Média</th><th class="num">Desvio padrão</th></tr>'+linhasM+'</table></div>'+
    '<div class="tabela-rolar"><table class="anova">'+
      '<tr><th>Fonte de variação</th><th class="num">SQ</th><th class="num">gl</th><th class="num">QM</th><th class="num">F</th><th class="num">valor de p</th></tr>'+
      '<tr><td>Entre grupos</td><td class="num">'+sqE.toFixed(2)+'</td><td class="num">'+glE+'</td><td class="num">'+qmE.toFixed(2)+
        '</td><td class="num destaq">'+F.toFixed(2)+'</td><td class="num destaq">'+(p<0.001?'&lt;0,001':p.toFixed(4).replace('.',','))+'</td></tr>'+
      '<tr><td>Dentro dos grupos</td><td class="num">'+sqD.toFixed(2)+'</td><td class="num">'+glD+'</td><td class="num">'+qmD.toFixed(2)+'</td><td></td><td></td></tr>'+
      '<tr><td>Total</td><td class="num">'+sqT.toFixed(2)+'</td><td class="num">'+(N-1)+'</td><td></td><td></td><td></td></tr>'+
      '<tr><td><strong>Eta quadrado</strong></td><td class="num destaq">'+eta.toFixed(3)+'</td><td colspan="4">proporção da variação total explicada pelo fator</td></tr>'+
    '</table></div>'+
    (p<0.05?
      '<h3>Comparações par a par</h3><div class="tabela-rolar"><table class="matriz">'+
      '<tr><th>Par</th><th class="num">Diferença</th><th class="num">LSD mínimo</th><th>Pelo LSD</th><th class="num">Bonferroni mínimo</th><th>Por Bonferroni</th><th class="num">p sem correção</th></tr>'+
      linhasC+'</table></div>'+
      '<div class="feedback ok"><strong>Leitura.</strong> A coluna do LSD mostra a menor diferença que seria considerada significativa sem correção. '+
      'A de Bonferroni mostra o mesmo com o nível dividido por '+nComp+', que é a rota mais conservadora. '+
      'O Tukey HSD fica entre as duas, porque corrige para o conjunto de comparações sem ser tão rígido quanto Bonferroni. '+
      'Rode o Tukey no PAST 4, em Statistics, One-way ANOVA, e confira: quando LSD e Bonferroni concordam, o Tukey concorda também. '+
      'Quando discordam, é ali que o Tukey decide, e essa é justamente a comparação que merece uma frase na discussão.</div>'
      :'<div class="feedback nao"><strong>A ANOVA não foi significativa, com p '+fmtP(p)+
      '. Portanto não se faz post hoc.</strong> Sair procurando pares até achar um significativo é exatamente o comportamento que a ANOVA existe para impedir. '+
      'O relato correto é que não houve evidência de diferença entre os grupos, e não que os grupos são iguais.</div>')+
    '<div class="feedback ok"><strong>Frase de relato pronta.</strong> A variável '+
    (p<0.05?'diferiu':'não diferiu de forma significativa')+' entre os '+k+' grupos, ANOVA de uma via, F igual a '+F.toFixed(2)+
    ' com '+glE+' e '+glD+' graus de liberdade, valor de p '+fmtP(p)+', eta quadrado igual a '+eta.toFixed(2)+
    '. Isso indica que cerca de '+(eta*100).toFixed(0)+' por cento da variação total é atribuível ao fator.</div>';
}
