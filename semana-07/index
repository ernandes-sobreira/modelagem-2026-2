  document.getElementById('sdLab').textContent=sd.toFixed(1).replace('.',',');
  document.getElementById('nLab').textContent=n;
  const se=sd*Math.sqrt(2/n);
  const t=se>0?dif/se:0,gl=2*n-2,p=pT(t,gl),d=sd>0?dif/sd:0;
  document.getElementById('sSinal').textContent=dif.toFixed(2);
  document.getElementById('sRuido').textContent=se.toFixed(3);
  document.getElementById('sT').textContent=t.toFixed(2);
  document.getElementById('sP').textContent=p<0.001?'<0,001':p.toFixed(4).replace('.',',');
  document.getElementById('sD').textContent=d.toFixed(2);
  const fb=document.getElementById('fbSinal');
  let m='<strong>A conta na sua frente.</strong> O sinal é '+dif.toFixed(2)+', o ruído é '+se.toFixed(3)+
    ', e a razão entre os dois dá t igual a '+t.toFixed(2)+'. ';
  m+=p<0.05?'Com p '+fmtP(p)+', o resultado é significativo. ':'Com p igual a '+p.toFixed(3).replace('.',',')+', o resultado não é significativo. ';
  m+='<br><br><strong>Agora o ponto da atividade.</strong> Não mexa na diferença. Mexa apenas no n e observe o valor de p desabar, com o sinal exatamente igual. Depois mexa apenas no desvio padrão e veja o mesmo efeito ao contrário. O d de Cohen, que está em '+d.toFixed(2)+
    ', é a única medida da tabela que não se move quando você mexe no n. É por isso que ele é a medida de tamanho de efeito, e o valor de p não é.';
  fb.innerHTML=m;fb.className=p<0.05?'feedback ok':'feedback nao';
}
