function calcularT(){
  const A=lerCaixa('grupo1'),B=lerCaixa('grupo2');
  const n1=document.getElementById('nome1').value||'grupo 1';
  const n2=document.getElementById('nome2').value||'grupo 2';
  const alvo=document.getElementById('saidaT');
  if(A.length<3||B.length<3){
    alvo.innerHTML='<div class="feedback nao">Cole pelo menos três valores em cada grupo.</div>';return;}
  const mA=media(A),mB=media(B),vA=varAm(A),vB=varAm(B),nA=A.length,nB=B.length;
  const dif=mA-mB;
  const seW=Math.sqrt(vA/nA+vB/nB);
  const tW=dif/seW;
  const glW=Math.pow(vA/nA+vB/nB,2)/(Math.pow(vA/nA,2)/(nA-1)+Math.pow(vB/nB,2)/(nB-1));
  const pW=pT(tW,glW);
  const sp2=((nA-1)*vA+(nB-1)*vB)/(nA+nB-2);
  const seS=Math.sqrt(sp2*(1/nA+1/nB));
  const tS=dif/seS,glS=nA+nB-2,pS=pT(tS,glS);
  const d=dif/Math.sqrt(sp2);
  let tc=0.5;
  while(tc<12&&pT(tc,glW)>0.05)tc+=0.005;
  const ic1=dif-tc*seW,ic2=dif+tc*seW;
  const razVar=Math.max(vA,vB)/Math.min(vA,vB);
  alvo.innerHTML=
