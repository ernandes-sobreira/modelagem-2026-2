function calcularBayes(){
  const N=1000;
  const prev=parseInt(document.getElementById('prev').value)/100;
  const sens=parseInt(document.getElementById('sens').value)/100;
  const esp=parseInt(document.getElementById('esp').value)/100;
  const tem=Math.round(N*prev),naoTem=N-tem;
  const vp=Math.round(tem*sens), fn=tem-vp;
  const fp=Math.round(naoTem*(1-esp)), vn=naoTem-fp;
  const post=(vp+fp)>0?vp/(vp+fp):0;
  document.getElementById('bTem').textContent=tem;
  document.getElementById('bVP').textContent=vp;
  document.getElementById('bFP').textContent=fp;
  document.getElementById('bPost').textContent=(post*100).toFixed(0)+'%';
  const total=N;
  document.getElementById('barraBayes').innerHTML=
    `<div style="background:#2e7d32;width:${vp/total*100}%">${vp>25?vp:''}</div>
     <div style="background:#c62828;width:${fp/total*100}%">${fp>25?fp:''}</div>
     <div style="background:#c9d0d8;color:#5a6472;width:${(vn+fn)/total*100}%">${vn+fn}</div>`;
  const fb=document.getElementById('fbBayes');
  let m='<strong>Leia assim.</strong> Em mil pontos, '+tem+' têm mesmo a espécie. O método acerta '+vp+
    ' deles. Mas entre os '+naoTem+' pontos sem a espécie, ele erra em '+fp+
    ', gerando positivos falsos. No total saíram '+(vp+fp)+' resultados positivos, e apenas '+vp+
    ' são verdadeiros. Ou seja, diante de um positivo, a chance de a espécie estar realmente ali é de '+(post*100).toFixed(0)+' por cento. ';
  if(post<0.5)m+='<strong>Menos da metade.</strong> Com um método de '+(sens*100).toFixed(0)+' por cento de sensibilidade, que parece excelente, a maioria dos positivos é falsa. O motivo é puramente aritmético: existem tão poucos pontos com a espécie que o pequeno percentual de erro sobre a enorme quantidade de pontos sem ela produz mais falsos positivos do que verdadeiros. Em consultoria, isso significa que confirmar um positivo com um segundo método não é preciosismo, é obrigação técnica.';
  else m+='Aumente ou diminua a ocorrência real na bacia e veja este número desabar. Quanto mais rara a espécie, menos confiável é um único resultado positivo, mesmo com o método sendo o mesmo.';
  fb.innerHTML=m;fb.className='feedback ok';
}
