<script>
/* ---------- utilitarios ---------- */
function normal(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function media(a){return a.reduce((x,y)=>x+y,0)/a.length;}
function varAmostra(a){const m=media(a);return a.reduce((x,y)=>x+(y-m)**2,0)/(a.length-1);}

/* funcao beta incompleta regularizada, para o valor de p do teste t */
function logGama(x){
  const c=[76.18009172947146,-86.50532032941677,24.01409824083091,
           -1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];
  let y=x,tmp=x+5.5;
  tmp-=(x+0.5)*Math.log(tmp);
  let ser=1.000000000190015;
  for(let j=0;j<6;j++)ser+=c[j]/++y;
  return -tmp+Math.log(2.5066282746310005*ser/x);
}
function betacf(a,b,x){
  const MAXIT=200,EPS=3e-14,FPMIN=1e-300;
  let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;
  if(Math.abs(d)<FPMIN)d=FPMIN;
  d=1/d;let h=d;
  for(let m=1;m<=MAXIT;m++){
    const m2=2*m;
    let aa=m*(b-m)*x/((qam+m2)*(a+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;h*=d*c;
    aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;
    const del=d*c;h*=del;
    if(Math.abs(del-1)<EPS)break;
  }
  return h;
}
function betai(a,b,x){
  if(x<=0)return 0;if(x>=1)return 1;
  const bt=Math.exp(logGama(a+b)-logGama(a)-logGama(b)+a*Math.log(x)+b*Math.log(1-x));
  return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b;
}
function pTeste(t,gl){return betai(gl/2,0.5,gl/(gl+t*t));}

/* ---------- ATIVIDADE 1 ---------- */
let difObservada=null;
document.getElementById('popN').addEventListener('input',e=>{
  document.getElementById('popNlabel').textContent=e.target.value;});
function sortearUmaVez(){
  const mu=parseFloat(document.getElementById('popMedia').value);
  const sd=parseFloat(document.getElementById('popDp').value);
  const n=parseInt(document.getElementById('popN').value);
  const A=[],B=[];
  for(let i=0;i<n;i++){A.push(normal(mu,sd));B.push(normal(mu,sd));}
  const mA=media(A),mB=media(B);
  difObservada=mA-mB;
  document.getElementById('mA').textContent=mA.toFixed(2);
  document.getElementById('mB').textContent=mB.toFixed(2);
  document.getElementById('mDif').textContent=difObservada.toFixed(2);
  const fb=document.getElementById('fbNuvem');
  fb.style.display='block';fb.className='feedback ok';
  fb.innerHTML='<strong>Os dois grupos vieram da mesma população.</strong> Nenhum tratamento foi aplicado, nada os distingue, e mesmo assim as médias deram diferente, com uma diferença de '+
    difObservada.toFixed(2)+'. Sorteie de novo e observe que a diferença muda toda vez. Agora clique em repetir mil vezes para ver a forma dessa variação.';
}
function mil(){
  const mu=parseFloat(document.getElementById('popMedia').value);
  const sd=parseFloat(document.getElementById('popDp').value);
  const n=parseInt(document.getElementById('popN').value);
  const difs=[];
  for(let k=0;k<1000;k++){
    const A=[],B=[];
    for(let i=0;i<n;i++){A.push(normal(mu,sd));B.push(normal(mu,sd));}
    difs.push(media(A)-media(B));
  }
  if(difObservada===null)sortearUmaVez();
  desenharNuvem(difs,difObservada);
  const extremos=difs.filter(d=>Math.abs(d)>=Math.abs(difObservada)).length;
  const fb=document.getElementById('fbNuvem');
  fb.style.display='block';fb.className='feedback ok';
  fb.innerHTML='<strong>Esta é a nuvem do acaso.</strong> Mil experimentos em que não existe efeito nenhum. Repare que ela se concentra em torno do zero, o que é esperado, mas se espalha bastante para os dois lados. Das mil diferenças, '+
    extremos+' ficaram tão distantes do zero quanto a sua diferença observada de '+difObservada.toFixed(2)+
    ', ou mais. Isso equivale a uma proporção de '+(extremos/1000).toFixed(3)+
    ', e é exatamente assim que um valor de p é construído: contando quanto da nuvem do acaso é tão extremo quanto o que você observou.';
}
function desenharNuvem(difs,obs){
  const cv=document.getElementById('grafNuvem'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=52,mD=26,mT=22,mB=52;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const lim=Math.max(Math.max(...difs.map(Math.abs)),Math.abs(obs))*1.08;
  const nb=41,larg=2*lim/nb;
  const bins=new Array(nb).fill(0);
  difs.forEach(d=>{let i=Math.floor((d+lim)/larg);if(i<0)i=0;if(i>=nb)i=nb-1;bins[i]++;});
  const maxB=Math.max(...bins);
  const x=v=>mE+((v+lim)/(2*lim))*(W-mE-mD);
  const y=c=>H-mB-(c/maxB)*(H-mT-mB);
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  bins.forEach((c,i)=>{
    if(!c)return;
    const x0=x(-lim+i*larg),x1=x(-lim+(i+1)*larg);
    ctx.fillStyle='#ef6c00';
    ctx.fillRect(x0+1,y(c),x1-x0-2,H-mB-y(c));
  });
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.strokeStyle='#c62828';ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(x(obs),mT);ctx.lineTo(x(obs),H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='13px sans-serif';ctx.textAlign='center';
  for(let i=0;i<=6;i++){const v=-lim+i*(2*lim)/6;ctx.fillText(v.toFixed(1),x(v),H-mB+22);}
  ctx.font='13.5px sans-serif';
  ctx.fillText('Diferença entre as médias dos dois grupos',(mE+W-mD)/2,H-14);
}

