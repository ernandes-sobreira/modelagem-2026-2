function calcAncova(){
  const nomes=[],gx=[],gy=[];
  ['1','2','3'].forEach(function(k){
    const d=lerPares('ad'+k);
    if(d.x.length>=4){gx.push(d.x);gy.push(d.y);nomes.push(document.getElementById('an'+k).value||('grupo '+k));}
  });
