  if(gx.length<2){
    alvo.innerHTML='<div class="feedback nao">Preencha pelo menos dois grupos, com quatro pares ou mais em cada. Separe a covariável da resposta por ponto e vírgula.</div>';return;}
  const ncov=document.getElementById('ncov').value||'covariável';
  const nresp=document.getElementById('nresp').value||'resposta';
  const R=ancova(gx,gy);
  let linhasIncl='';
  R.bi.forEach(function(b,i){
    linhasIncl+='<tr><td>'+nomes[i]+'</td><td class="num">'+gx[i].length+'</td><td class="num">'+b.toFixed(3)+'</td></tr>';
  });
  let html=
    '<h3>Passo 1: teste de homogeneidade das inclinações</h3>'+
    '<div class="tabela-rolar"><table><tr><th>Grupo</th><th class="num">n</th><th class="num">Inclinação estimada</th></tr>'+
    linhasIncl+'<tr><td><strong>Inclinação comum</strong></td><td class="num">'+R.N+'</td><td class="num destaq">'+R.bComum.toFixed(3)+'</td></tr></table></div>'+
    '<div class="tabela-rolar"><table class="anova"><tr><th>Teste</th><th class="num">F</th><th class="num">gl</th><th class="num">valor de p</th></tr>'+
    '<tr><td>Interação entre grupo e '+ncov+'</td><td class="num destaq">'+R.Fpar.toFixed(2)+'</td><td class="num">'+R.glParNum+' e '+R.glParDen+
    '</td><td class="num destaq">'+fmtPc(R.pPar)+'</td></tr></table></div>';
  if(R.pPar<0.05){
    html+='<div class="feedback nao"><strong>Pressuposto violado. A ANCOVA clássica não se aplica aqui.</strong><br><br>'+
      'A interação entre o grupo e a covariável deu p '+fmtP(R.pPar)+', o que significa que as inclinações diferem entre os grupos. '+
      'As inclinações estimadas foram '+R.bi.map(function(b){return b.toFixed(3);}).join(', ')+
      ', e elas não podem ser resumidas em um número único. '+
      'Como a distância vertical entre as retas muda conforme o valor de '+ncov+', não existe uma diferença única entre os grupos, e portanto não faz sentido calcular médias ajustadas. '+
      '<br><br><strong>Isso não é um fracasso, é um resultado.</strong> Siga uma das três condutas da seção 5: relatar a interação como achado principal, descrevendo a inclinação de cada grupo, comparar os grupos em valores específicos da covariável, ou restringir a análise a uma faixa onde as retas sejam aproximadamente paralelas. '+
      'A calculadora não segue adiante de propósito, porque seguir seria produzir números sem significado.</div>';
    alvo.innerHTML=html;return;
  }
  let linhasM='';
  for(let i=0;i<R.k;i++){
    linhasM+='<tr><td>'+nomes[i]+'</td><td class="num">'+R.mx[i].toFixed(2)+'</td><td class="num">'+R.my[i].toFixed(2)+
