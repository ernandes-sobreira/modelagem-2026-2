  }
  html+=
    '<div class="feedback ok"><strong>Pressuposto atendido.</strong> A interação deu p '+fmtP(R.pPar)+
    ', então as inclinações podem ser consideradas homogêneas e a ANCOVA é aplicável. A inclinação comum estimada é '+R.bComum.toFixed(3)+
    ' unidades de '+nresp+' por unidade de '+ncov+'.</div>'+
    '<h3>Passo 2: a tabela da ANCOVA</h3>'+
    '<div class="tabela-rolar"><table class="anova">'+
    '<tr><th>Fonte</th><th class="num">SQ</th><th class="num">gl</th><th class="num">F</th><th class="num">valor de p</th></tr>'+
    '<tr><td>'+ncov+', a covariável</td><td class="num">'+R.SScov.toFixed(2)+'</td><td class="num">1</td><td class="num">'+R.Fcov.toFixed(2)+'</td><td class="num">'+fmtPc(R.pCov)+'</td></tr>'+
