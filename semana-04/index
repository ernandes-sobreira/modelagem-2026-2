function cemExperimentos(){
  const ef=parseFloat(document.getElementById('efeito').value);
  const sd=parseFloat(document.getElementById('efDp').value);
  const n=parseInt(document.getElementById('efN').value);
  const ps=[];
  for(let k=0;k<100;k++){
    const A=[],B=[];
    for(let i=0;i<n;i++){A.push(normal(50,sd));B.push(normal(50+ef,sd));}
    const mA=media(A),mB=media(B);
    const vA=varAmostra(A),vB=varAmostra(B);
    const sp=Math.sqrt(((n-1)*vA+(n-1)*vB)/(2*n-2));
    const t=(mA-mB)/(sp*Math.sqrt(2/n));
    ps.push(pTeste(t,2*n-2));
  }
  const sig=ps.filter(p=>p<0.05).length;
  document.getElementById('cSig').textContent=sig;
  document.getElementById('cNao').textContent=100-sig;
  document.getElementById('cMin').textContent=Math.min(...ps).toFixed(4);
  desenharP(ps);
  const fb=document.getElementById('fbCem');
  fb.style.display='block';
  if(ef===0){
    fb.className='feedback nao';
    fb.innerHTML='<strong>Não existe efeito nenhum aqui.</strong> Os dois grupos foram sorteados da mesma população, e ainda assim '+
      sig+' dos 100 experimentos deram resultado significativo. Isso não é defeito do simulador, é a definição do limite de 0,05: você aceita, de antemão, errar em cerca de 5 por cento das vezes quando não há efeito. Cada uma dessas '+
      sig+' barras vermelhas é um erro tipo I, um falso positivo. Pense no que significa uma literatura inteira publicando só os resultados significativos.';
  }else{
    fb.className='feedback ok';
    fb.innerHTML='<strong>Agora existe um efeito real de '+ef+' unidades.</strong> Dos 100 experimentos, '+sig+
      ' conseguiram detectá-lo e '+(100-sig)+' não conseguiram. Cada um desses '+(100-sig)+
      ' é um erro tipo II, um falso negativo: o efeito estava lá e o experimento não enxergou. Aumente o n e rode de novo. Você vai ver a capacidade de detectar subir, que é exatamente o que a Semana 3 chamou de esforço amostral.';
  }
}
function desenharP(ps){
  const cv=document.getElementById('grafP'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=52,mD=26,mT=22,mB=48;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const nb=20,bins=new Array(nb).fill(0),sigb=new Array(nb).fill(0);
  ps.forEach(p=>{let i=Math.floor(p*nb);if(i>=nb)i=nb-1;bins[i]++;if(p<0.05)sigb[i]++;});
  const maxB=Math.max(...bins,1);
  const x=v=>mE+v*(W-mE-mD);
  const y=c=>H-mB-(c/maxB)*(H-mT-mB);
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  bins.forEach((c,i)=>{
    if(!c)return;
    const x0=x(i/nb),x1=x((i+1)/nb);
    ctx.fillStyle=sigb[i]>0?'#c62828':'#c9d0d8';
    ctx.fillRect(x0+1,y(c),x1-x0-2,H-mB-y(c));
  });
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='13px sans-serif';ctx.textAlign='center';
  [0,0.2,0.4,0.6,0.8,1].forEach(v=>ctx.fillText(v.toFixed(1),x(v),H-mB+22));
  ctx.font='13.5px sans-serif';
  ctx.fillText('Valor de p obtido em cada um dos cem experimentos',(mE+W-mD)/2,H-12);
}

