function lerPares(id){
  const x=[],y=[];
  document.getElementById(id).value.split(/\n/).forEach(function(l){
    const p=l.split(/[;\t]+/).map(function(s){return s.trim().replace(',','.');}).filter(function(s){return s!=='';});
    if(p.length>=2){
      const a=Number(p[0]),b=Number(p[1]);
      if(!isNaN(a)&&!isNaN(b)){x.push(a);y.push(b);}
    }
  });
  return {x:x,y:y};
}
