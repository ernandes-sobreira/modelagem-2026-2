const criterios=[
 {c:'Clareza da pergunta',d:'Pergunta, hipótese e predição enunciadas de forma direta e falseável'},
 {c:'Domínio do delineamento',d:'Unidade amostral, réplicas, aleatorização e croqui explicados sem hesitação'},
 {c:'Adequação da análise',d:'Teste compatível com o dado, pressupostos verificados e declarados'},
 {c:'Apresentação dos resultados',d:'Figura legível, barra de erro identificada, números ditos com unidade'},
 {c:'Discussão e aplicação',d:'Significado do achado e ligação explícita com consultoria ambiental'},
 {c:'Arguição',d:'Respostas consistentes e reconhecimento honesto de limitações'}
];
(function(){
  let html='';
  criterios.forEach(function(k,i){
    html+='<div class="caso"><div class="n">'+k.c+'</div><p style="margin-bottom:10px;font-size:14.5px;color:var(--cinza)">'+k.d+'</p>'+
      '<div class="opcoes">'+
      '<button class="opcao" onclick="notaCrit('+i+',1,this)">Ainda não</button>'+
      '<button class="opcao" onclick="notaCrit('+i+',2,this)">Parcialmente</button>'+
      '<button class="opcao" onclick="notaCrit('+i+',3,this)">Quase pronto</button>'+
      '<button class="opcao" onclick="notaCrit('+i+',4,this)">Pronto</button>'+
      '</div></div>';
  });
  document.getElementById('rubrica').innerHTML=html;
})();
const notas=[0,0,0,0,0,0];
function notaCrit(i,v,btn){
  const pai=btn.parentElement;
  Array.from(pai.children).forEach(function(b){b.classList.remove('certa');});
  btn.classList.add('certa');
  notas[i]=v;
  let soma=0,faltam=0;
  notas.forEach(function(n){if(n===0)faltam++;else soma+=n;});
  const fb=document.getElementById('fbRubrica');
  if(faltam>0){
    document.getElementById('notaPrev').textContent='-';
    fb.className='feedback ok';
    fb.innerHTML='Faltam '+faltam+' critério(s) para avaliar.';
    return;
  }
  const nota=soma/24*10;
  document.getElementById('notaPrev').textContent=nota.toFixed(1).replace('.',',');
  const fracos=[];
  notas.forEach(function(n,i){if(n<=2)fracos.push(criterios[i].c.toLowerCase());});
  if(fracos.length===0){fb.className='feedback ok';
    fb.innerHTML='<strong>Grupo preparado.</strong> Os seis critérios estão em bom estado. Faça mais um ensaio com o cronômetro e sorteie dez perguntas de arguição para confirmar. E lembre que a autoavaliação tende a ser generosa: peça a alguém de fora do grupo para assistir ao ensaio.';}
  else{fb.className='feedback nao';
    fb.innerHTML='<strong>Concentre o ensaio em: '+fracos.join(', ')+'.</strong> '+
      'Esses são os critérios com maior distância até o pronto, e cada um vale um sexto da nota da apresentação. '+
      'Se o ponto fraco for arguição, use a Atividade 2. Se for apresentação dos resultados, refaça a figura principal seguindo as regras da Semana 12. '+
      'Se for domínio do delineamento, volte ao protocolo entregue na Semana 3 e retome as decisões que o grupo tomou lá.';}
}
