  if(pai.dataset.feito)return;pai.dataset.feito='1';
  Array.from(pai.children).forEach(function(b){b.disabled=true;});
  const fb=document.getElementById('fbq'+i);
  if(j===perguntas[i].c){btn.classList.add('certa');fb.className='feedback ok';
    fb.innerHTML='<strong>Correto.</strong> '+perguntas[i].j;}
  else{btn.classList.add('errada');pai.children[perguntas[i].c].classList.add('certa');
    fb.className='feedback nao';fb.innerHTML='<strong>Não é isso.</strong> '+perguntas[i].j;}
  respFinal++;
  document.getElementById('placarFinal').textContent='Respondidas: '+respFinal+' de 6';
}
