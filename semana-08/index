function verF(){
  const sep=parseInt(document.getElementById('sep').value);
  const dis=parseInt(document.getElementById('dis').value);
  const n=parseInt(document.getElementById('nf').value);
  document.getElementById('sepLab').textContent=sep;
  document.getElementById('disLab').textContent=dis;
  document.getElementById('nfLab').textContent=n;
  const grupos=[];
  for(let g=0;g<3;g++){
    const a=[];
    for(let i=0;i<n;i++)a.push(normalR(50+g*sep,dis));
    grupos.push(a);
  }
  const todos=grupos.flat(),N=todos.length,mg=media(todos);
  let sqE=0,sqD=0;
  grupos.forEach(function(g){
    const m=media(g);
    sqE+=g.length*(m-mg)*(m-mg);
    g.forEach(function(v){sqD+=(v-m)*(v-m);});
  });
  const glE=2,glD=N-3;
  const qmE=sqE/glE,qmD=sqD/glD,F=qmE/qmD,p=pF(F,glE,glD),eta=sqE/(sqE+sqD);
  document.getElementById('qmE').textContent=qmE.toFixed(1);
  document.getElementById('qmD').textContent=qmD.toFixed(1);
  document.getElementById('fVal').textContent=F.toFixed(2);
  document.getElementById('fP').textContent=p<0.001?'<0,001':p.toFixed(4).replace('.',',');
  document.getElementById('fEta').textContent=eta.toFixed(2);
  const cv=document.getElementById('grafF'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=52,mD=26,mT=22,mB=50;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const lo=Math.min.apply(null,todos)-2,hi=Math.max.apply(null,todos)+2;
  const py=function(v){return H-mB-((v-lo)/(hi-lo||1))*(H-mT-mB);};
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  ctx.strokeStyle='#8d6e63';ctx.lineWidth=2.6;ctx.setLineDash([7,5]);
  ctx.beginPath();ctx.moveTo(mE,py(mg));ctx.lineTo(W-mD,py(mg));ctx.stroke();ctx.setLineDash([]);
  grupos.forEach(function(g,gi){
    const cx=mE+(gi+0.5)*(W-mE-mD)/3;
    g.forEach(function(v){
      ctx.fillStyle='rgba(78,52,46,.6)';
      ctx.beginPath();ctx.arc(cx+(Math.random()-0.5)*95,py(v),5.5,0,2*Math.PI);ctx.fill();});
    const m=media(g);
    ctx.strokeStyle='#c62828';ctx.lineWidth=3.6;
    ctx.beginPath();ctx.moveTo(cx-62,py(m));ctx.lineTo(cx+62,py(m));ctx.stroke();
    ctx.fillStyle='#22272e';ctx.font='bold 13px sans-serif';ctx.textAlign='center';
    ctx.fillText('grupo '+(gi+1),cx,H-mB+22);
  });
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  const fb=document.getElementById('fbF');
  let m='<strong>As duas fontes disputando.</strong> O quadrado médio entre grupos é '+qmE.toFixed(1)+
    ' e o de dentro dos grupos é '+qmD.toFixed(1)+'. A razão entre eles dá F igual a '+F.toFixed(2)+'. ';
  if(sep===0)m+='<br><br>Você zerou a separação entre as médias, então as três linhas vermelhas estão praticamente sobre a linha da média geral. O F deveria ficar perto de 1, e é isso que significa não haver novidade nenhuma nos dados.';
  else if(F<2)m+='<br><br>F próximo de 1 significa que a variação entre os grupos é do mesmo tamanho da variação dentro deles. Repare no gráfico: as nuvens se sobrepõem. Aumente a separação ou diminua a dispersão e veja o que acontece.';
  else if(p<0.05)m+='<br><br>Com p '+fmtP(p)+', o resultado é significativo, e o eta quadrado de '+eta.toFixed(2)+' indica que cerca de '+(eta*100).toFixed(0)+' por cento da variação total vem do fator. Repare que as nuvens agora se separam visualmente. Agora aumente só a dispersão e veja a significância desaparecer sem que as médias tenham mudado de lugar.';
  else m+='<br><br>Ainda não é significativo. Suba o n e observe: as médias continuam nas mesmas posições, a dispersão continua igual, e mesmo assim o F sobe. É o esforço amostral da Semana 3 trabalhando dentro da ANOVA.';
  fb.innerHTML=m;fb.className=p<0.05?'feedback ok':'feedback nao';
}
