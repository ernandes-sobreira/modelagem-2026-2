/* ---------- ATIVIDADE 4 ---------- */
document.getElementById('lambda').addEventListener('input',e=>{
  document.getElementById('lamLabel').textContent=(e.target.value/10).toFixed(1).replace('.',',');});
document.getElementById('narm').addEventListener('input',e=>{
  document.getElementById('armLabel').textContent=e.target.value;});
function sortPoisson(lam){
  const L=Math.exp(-lam);let k=0,p=1;
  do{k++;p*=Math.random();}while(p>L);
  return k-1;
}
function poisson(){
  const lam=parseInt(document.getElementById('lambda').value)/10;
  const n=parseInt(document.getElementById('narm').value);
  const v=[];for(let i=0;i<n;i++)v.push(sortPoisson(lam));
  const m=media(v);
  const varn=v.reduce((a,b)=>a+(b-m)**2,0)/(v.length-1);
  const zeros=v.filter(x=>x===0).length;
  const max=Math.max(...v);
  document.getElementById('poMedia').textContent=m.toFixed(2);
  document.getElementById('poVar').textContent=varn.toFixed(2);
  document.getElementById('poZero').textContent=zeros+' ('+(zeros/n*100).toFixed(0)+'%)';
  document.getElementById('poMax').textContent=max;
  const bins=new Array(max+1).fill(0);
  v.forEach(x=>bins[x]++);
  histograma('grafPoisson',bins,0,1,'#00695c','Número de indivíduos na armadilha');
  const fb=document.getElementById('fbPoisson');
  fb.style.display='block';
  if(lam<3){
    fb.className='feedback nao';
    fb.innerHTML='<strong>Isto não tem nada de sino.</strong> Com média de '+m.toFixed(2)+
      ' indivíduos por armadilha, '+(zeros/n*100).toFixed(0)+
      ' por cento das armadilhas vieram vazias e a distribuição está espremida contra o zero, com cauda para a direita. Repare também que a variância, '+varn.toFixed(2)+
      ', ficou próxima da média, que é a assinatura da Poisson. Aplicar teste t ou ANOVA aqui viola pressupostos de imediato: a variância não é constante, a forma não é simétrica e o modelo permitiria prever contagens negativas. É exatamente para esse caso que existem os Modelos Lineares Generalizados da Semana 15.';
  }else{
    fb.className='feedback ok';
    fb.innerHTML='<strong>Agora começa a parecer um sino.</strong> Com média de '+m.toFixed(2)+
      ', apenas '+(zeros/n*100).toFixed(0)+' por cento das armadilhas vieram vazias e a forma ficou mais simétrica. Quando a média de uma Poisson é alta, ela se aproxima da normal e os testes tradicionais passam a funcionar razoavelmente. Baixe o controle para valores pequenos e veja a forma desmontar. A regra prática é desconfiar sempre que a média de contagem for menor que cinco.';
  }
}
