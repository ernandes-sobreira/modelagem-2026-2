function simAncova(){
  const eg=parseInt(document.getElementById('eg').value);
  const ec=parseInt(document.getElementById('ec').value);
  const ef=parseInt(document.getElementById('ef').value)/10;
  const ep=parseInt(document.getElementById('ep').value);
  const n=18;
  const gx=[[],[]],gy=[[],[]];
  for(let g=0;g<2;g++)for(let i=0;i<n;i++){
    const x=50+(g===1?ec:0)+normalR(0,4);
    const y=40+(g===1?eg:0)+ef*(x-50)+normalR(0,ep);
    gx[g].push(x);gy[g].push(y);
  }
  const R=ancova(gx,gy);
  document.getElementById('s1Bruta').textContent=R.my[0].toFixed(1)+' e '+R.my[1].toFixed(1);
  document.getElementById('s1Ajust').textContent=R.ajust[0].toFixed(1)+' e '+R.ajust[1].toFixed(1);
  document.getElementById('s1PAnova').textContent=fmtPc(R.pAnova);
  document.getElementById('s1PAncova').textContent=fmtPc(R.pGrupo);
  /* grafico */
  const cv=document.getElementById('grafAnc'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=56,mD=24,mT=22,mB=50;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const allX=gx[0].concat(gx[1]),allY=gy[0].concat(gy[1]);
  const X0=Math.min.apply(null,allX)-2,X1=Math.max.apply(null,allX)+2;
  const Y0=Math.min.apply(null,allY)-2,Y1=Math.max.apply(null,allY)+2;
  const px=function(v){return mE+((v-X0)/(X1-X0))*(W-mE-mD);};
  const py=function(v){return H-mB-((v-Y0)/(Y1-Y0))*(H-mT-mB);};
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){const yy=mT+i*(H-mT-mB)/4;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  const cores=['#ad1457','#0277bd'];
  for(let g=0;g<2;g++){
    const a=R.my[g]-R.bComum*R.mx[g];
    ctx.strokeStyle='#5a6472';ctx.lineWidth=2.6;
    ctx.beginPath();ctx.moveTo(px(X0),py(a+R.bComum*X0));ctx.lineTo(px(X1),py(a+R.bComum*X1));ctx.stroke();
    for(let i=0;i<gx[g].length;i++){
      ctx.fillStyle=cores[g];
      ctx.beginPath();ctx.arc(px(gx[g][i]),py(gy[g][i]),6,0,2*Math.PI);ctx.fill();
      ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke();
    }
  }
  ctx.strokeStyle='#8d6e63';ctx.lineWidth=2;ctx.setLineDash([6,5]);
  ctx.beginPath();ctx.moveTo(px(R.mgx),mT);ctx.lineTo(px(R.mgx),H-mB);ctx.stroke();ctx.setLineDash([]);
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='12.5px sans-serif';ctx.textAlign='center';
  for(let i=0;i<=4;i++){const v=X0+(X1-X0)*i/4;ctx.fillText(v.toFixed(0),px(v),H-mB+20);}
  ctx.textAlign='right';
  for(let i=0;i<=4;i++){const v=Y1-(Y1-Y0)*i/4;ctx.fillText(v.toFixed(0),mE-8,mT+i*(H-mT-mB)/4+4);}
  ctx.textAlign='center';ctx.font='13px sans-serif';
  ctx.fillText('Covariável, a linha tracejada marca a média geral',(mE+W-mD)/2,H-10);
  ctx.save();ctx.translate(15,(mT+H-mB)/2);ctx.rotate(-Math.PI/2);
  ctx.fillText('Resposta',0,0);ctx.restore();
  const fb=document.getElementById('fbAnc');
  let m='',cls='ok';
  const difBruta=Math.abs(R.my[1]-R.my[0]),difAj=Math.abs(R.ajust[1]-R.ajust[0]);
  if(R.pAnova<0.05&&R.pGrupo>=0.05){cls='nao';
    m='<strong>A ANOVA achou o que não existe.</strong> Ignorando a covariável, a diferença bruta de '+difBruta.toFixed(1)+
      ' unidades deu significativa. Descontando a covariável, a diferença cai para '+difAj.toFixed(1)+
      ' e deixa de ser significativa. O que a ANOVA chamou de efeito do grupo era, na verdade, o desequilíbrio da covariável entre os grupos. É exatamente o caso dos ovos da seção 1.';}
  else if(R.pAnova>=0.05&&R.pGrupo<0.05){cls='ok';
    m='<strong>A ANCOVA enxergou o que a ANOVA não viu.</strong> Sem o ajuste, o valor de p era '+R.pAnova.toFixed(3).replace('.',',')+
      ' e nada seria detectado. Com o ajuste, o p caiu para '+fmtPc(R.pGrupo)+
      '. Duas coisas aconteceram ao mesmo tempo: a covariável estava mascarando o efeito, e retirar a variação explicada por ela reduziu o resíduo, o que aumentou a capacidade do teste. É o ganho de poder da seção 6.';}
  else if(R.pGrupo<0.05){
    m='<strong>Efeito confirmado nas duas análises.</strong> Diferença bruta de '+difBruta.toFixed(1)+
      ' e ajustada de '+difAj.toFixed(1)+'. Mesmo assim, repare no tamanho do ajuste: ele mostra quanto da diferença aparente vinha da covariável. Agora aumente o desequilíbrio da covariável e observe as duas conclusões se separarem.';}
  else{
    m='<strong>Nenhuma das duas análises detectou efeito de grupo.</strong> Diferença bruta de '+difBruta.toFixed(1)+
      ' e ajustada de '+difAj.toFixed(1)+'. Mexa no efeito real do grupo, ou no desequilíbrio da covariável, e observe as duas conclusões deixarem de concordar. Os casos interessantes são justamente aqueles em que ANOVA e ANCOVA discordam.';}
  m+='<br><br>Inclinação comum estimada: '+R.bComum.toFixed(3)+
     '. As duas retas do gráfico são paralelas por construção do modelo, e a distância vertical entre elas é o efeito do grupo já ajustado.';
  fb.innerHTML=m;fb.className='feedback '+cls;
}
