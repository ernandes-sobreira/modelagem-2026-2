/* ---------- ATIVIDADE 3 ---------- */
function normal(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
document.getElementById('simN').addEventListener('input',e=>{
  document.getElementById('simNlabel').textContent=e.target.value;rodarSimulacao();});
function rodarSimulacao(){
  const mu=parseFloat(document.getElementById('simMedia').value);
  const sd=parseFloat(document.getElementById('simDp').value);
  const n=parseInt(document.getElementById('simN').value);
  if(isNaN(mu)||isNaN(sd)||sd<=0){return;}
  const am=[];for(let i=0;i<n;i++)am.push(normal(mu,sd));
  const med=am.reduce((a,b)=>a+b,0)/n;
  const dp=Math.sqrt(am.reduce((a,b)=>a+(b-med)**2,0)/(n-1));
  const ep=dp/Math.sqrt(n);
  document.getElementById('outMedia').textContent=med.toFixed(2);
  document.getElementById('outDp').textContent=dp.toFixed(2);
  document.getElementById('outEp').textContent=ep.toFixed(2);
  document.getElementById('outIc').textContent=(1.96*ep).toFixed(2);
  desenharEp(sd,n);
  const fb=document.getElementById('fbSim');
  fb.style.display='block';fb.className='feedback ok';
  fb.innerHTML='<strong>Leia assim.</strong> Com n igual a '+n+', o erro padrão ficou em '+ep.toFixed(2)+
    '. Para reduzir esse erro pela metade, para perto de '+(sd/Math.sqrt(n*4)).toFixed(2)+
    ', seria preciso chegar a n igual a '+(n*4)+'. Quadruplicar o esforço para dobrar a precisão é o preço da raiz quadrada, e é a razão pela qual todo dimensionamento amostral é uma negociação entre rigor e orçamento.';
}
function desenharEp(sd,nAtual){
  const cv=document.getElementById('graficoEp'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mE=62,mD=22,mT=22,mB=52;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const nMax=60,epMax=sd/Math.sqrt(2);
  const x=n=>mE+((n-2)/(nMax-2))*(W-mE-mD);
  const y=v=>H-mB-(v/epMax)*(H-mT-mB);
  ctx.strokeStyle='#eef1f4';ctx.lineWidth=1;
  for(let i=0;i<=5;i++){const yy=mT+i*(H-mT-mB)/5;
    ctx.beginPath();ctx.moveTo(mE,yy);ctx.lineTo(W-mD,yy);ctx.stroke();}
  ctx.strokeStyle='#95a1b0';ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(mE,mT);ctx.lineTo(mE,H-mB);ctx.lineTo(W-mD,H-mB);ctx.stroke();
  ctx.fillStyle='#5a6472';ctx.font='13px sans-serif';ctx.textAlign='right';
  for(let i=0;i<=5;i++){const v=epMax*(1-i/5),yy=mT+i*(H-mT-mB)/5;
    ctx.fillText(v.toFixed(1),mE-9,yy+4);}
  ctx.textAlign='center';
  [2,10,20,30,40,50,60].forEach(n=>ctx.fillText(n,x(n),H-mB+22));
  ctx.font='13.5px sans-serif';
  ctx.fillText('Número de réplicas (n)',(mE+W-mD)/2,H-14);
  ctx.save();ctx.translate(17,(mT+H-mB)/2);ctx.rotate(-Math.PI/2);
  ctx.fillText('Erro padrão da média',0,0);ctx.restore();
  ctx.strokeStyle='#6a1b9a';ctx.lineWidth=3;ctx.beginPath();
  for(let n=2;n<=nMax;n++){const px=x(n),py=y(sd/Math.sqrt(n));
    n===2?ctx.moveTo(px,py):ctx.lineTo(px,py);}
  ctx.stroke();
  const px=x(nAtual),py=y(sd/Math.sqrt(nAtual));
  ctx.strokeStyle='#e65100';ctx.lineWidth=2;ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(px,H-mB);ctx.lineTo(px,py);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#e65100';ctx.beginPath();ctx.arc(px,py,7,0,2*Math.PI);ctx.fill();
  ctx.strokeStyle='#fff';ctx.lineWidth=2.5;ctx.stroke();
}
