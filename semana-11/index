<script>
function normalR(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function media(a){return a.reduce(function(x,y){return x+y;},0)/a.length;}
function logGama(x){
  const c=[76.18009172947146,-86.50532032941677,24.01409824083091,
           -1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];
  let y=x,tmp=x+5.5;
  tmp-=(x+0.5)*Math.log(tmp);
  let ser=1.000000000190015;
  for(let j=0;j<6;j++)ser+=c[j]/++y;
  return -tmp+Math.log(2.5066282746310005*ser/x);
}
function betacf(a,b,x){
  const MAXIT=250,EPS=3e-14,FPMIN=1e-300;
  let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;
  if(Math.abs(d)<FPMIN)d=FPMIN;
  d=1/d;let h=d;
  for(let m=1;m<=MAXIT;m++){
    const m2=2*m;
    let aa=m*(b-m)*x/((qam+m2)*(a+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;h*=d*c;
    aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;
    const del=d*c;h*=del;
    if(Math.abs(del-1)<EPS)break;
  }
  return h;
}
function betai(a,b,x){
  if(x<=0)return 0;if(x>=1)return 1;
  const bt=Math.exp(logGama(a+b)-logGama(a)-logGama(b)+a*Math.log(x)+b*Math.log(1-x));
  return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b;
}
function pF(F,gl1,gl2){
  if(F<=0||!isFinite(F))return 1;
  return betai(gl2/2,gl1/2,gl2/(gl2+gl1*F));
}
function fmtP(p){return p<0.001?'menor que 0,001':'igual a '+p.toFixed(4).replace('.',',');}
function fmtPc(p){return p<0.001?'&lt;0,001':p.toFixed(4).replace('.',',');}

/* ANCOVA para k grupos, cada grupo com vetores x e y */
function ancova(gx,gy){
  const k=gx.length;
  let N=0;
  const allX=[],allY=[];
  for(let i=0;i<k;i++){N+=gx[i].length;
    gx[i].forEach(function(v){allX.push(v);});
    gy[i].forEach(function(v){allY.push(v);});}
  const mgx=media(allX),mgy=media(allY);
  /* somas totais corrigidas */
  let Txx=0,Txy=0,Tyy=0;
  for(let i=0;i<N;i++){
    Txx+=(allX[i]-mgx)*(allX[i]-mgx);
    Txy+=(allX[i]-mgx)*(allY[i]-mgy);
    Tyy+=(allY[i]-mgy)*(allY[i]-mgy);
  }
  /* somas dentro dos grupos */
  let Wxx=0,Wxy=0,Wyy=0;
  const mx=[],my=[],bi=[],SSEi=[];
  for(let i=0;i<k;i++){
    const xi=gx[i],yi=gy[i],mxi=media(xi),myi=media(yi);
    mx.push(mxi);my.push(myi);
    let sxx=0,sxy=0,syy=0;
    for(let j=0;j<xi.length;j++){
      sxx+=(xi[j]-mxi)*(xi[j]-mxi);
      sxy+=(xi[j]-mxi)*(yi[j]-myi);
      syy+=(yi[j]-myi)*(yi[j]-myi);
    }
    Wxx+=sxx;Wxy+=sxy;Wyy+=syy;
    const b=sxy/sxx;
    bi.push(b);
    SSEi.push(syy-sxy*sxy/sxx);
  }
  const bComum=Wxy/Wxx;
  /* modelo com inclinacoes separadas */
  const SSEfull=SSEi.reduce(function(a,b){return a+b;},0);
  const glFull=N-2*k;
  /* modelo com inclinacao comum */
  const SSEcomum=Wyy-Wxy*Wxy/Wxx;
  const glComum=N-k-1;
  /* teste de paralelismo */
  const Fpar=((SSEcomum-SSEfull)/(k-1))/(SSEfull/glFull);
  const pPar=pF(Fpar,k-1,glFull);
  /* modelo so com covariavel, ignorando grupos */
  const SSEreg=Tyy-Txy*Txy/Txx;
  const SSgrupo=SSEreg-SSEcomum;
  const QME=SSEcomum/glComum;
  const Fgrupo=(SSgrupo/(k-1))/QME;
  const pGrupo=pF(Fgrupo,k-1,glComum);
  /* efeito da covariavel */
  const SScov=Wxy*Wxy/Wxx;
  const Fcov=SScov/QME;
  const pCov=pF(Fcov,1,glComum);
  /* medias ajustadas */
  const ajust=[];
  for(let i=0;i<k;i++)ajust.push(my[i]-bComum*(mx[i]-mgx));
  /* ANOVA ignorando a covariavel */
  let SQentre=0;
  for(let i=0;i<k;i++)SQentre+=gy[i].length*(my[i]-mgy)*(my[i]-mgy);
  const SQdentro=Wyy;
  const Fanova=(SQentre/(k-1))/(SQdentro/(N-k));
  const pAnova=pF(Fanova,k-1,N-k);
  return {k:k,N:N,mgx:mgx,mgy:mgy,mx:mx,my:my,bi:bi,bComum:bComum,ajust:ajust,
    Fpar:Fpar,pPar:pPar,glParNum:k-1,glParDen:glFull,
    SScov:SScov,Fcov:Fcov,pCov:pCov,
    SSgrupo:SSgrupo,Fgrupo:Fgrupo,pGrupo:pGrupo,glGrupo:k-1,glRes:glComum,
    SSEcomum:SSEcomum,QME:QME,
    Fanova:Fanova,pAnova:pAnova};
}

