let respSlide=0;
(function(){
  const c=document.getElementById('quizSlide');
  slides.forEach(function(k,i){
    const d=document.createElement('div');d.className='caso';
    const bts=k.o.map(function(op,j){
      return '<button class="opcao" style="flex:1 1 100%;text-align:left" onclick="respSl('+i+','+j+',this)">'+op+'</button>';}).join('');
    d.innerHTML='<div class="n">Slide '+(i+1)+'</div><p style="margin-bottom:10px">'+k.t+'</p>'+
      '<div class="opcoes" style="flex-direction:column">'+bts+'</div>'+
      '<div class="feedback" id="fbsl'+i+'"></div>';
    c.appendChild(d);
  });
})();
function respSl(i,j,btn){
  const pai=btn.parentElement;
  if(pai.dataset.feito)return;pai.dataset.feito='1';
  Array.from(pai.children).forEach(function(b){b.disabled=true;});
  const fb=document.getElementById('fbsl'+i);
  if(j===slides[i].c){btn.classList.add('certa');fb.className='feedback ok';
    fb.innerHTML='<strong>Correto.</strong> '+slides[i].j;}
  else{btn.classList.add('errada');pai.children[slides[i].c].classList.add('certa');
    fb.className='feedback nao';fb.innerHTML='<strong>Não é isso.</strong> '+slides[i].j;}
  respSlide++;
  document.getElementById('placarSlide').textContent='Respondidas: '+respSlide+' de 7';
}

