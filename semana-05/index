document.getElementById('tclN').addEventListener('input',e=>{
  document.getElementById('tclNlabel').textContent=e.target.value;tcl();});
function popTorta(){
  return Math.exp(normal(0,1))*2;
}
function tcl(){
  const n=parseInt(document.getElementById('tclN').value);
  const medias=[];
  for(let k=0;k<1000;k++){
    let s=0;for(let i=0;i<n;i++)s+=popTorta();
    medias.push(s/n);
  }
  const lo=0,hi=Math.max(...medias);
  const nb=40,larg=(hi-lo)/nb;
  const bins=new Array(nb).fill(0);
  medias.forEach(x=>{let i=Math.floor((x-lo)/larg);if(i>=nb)i=nb-1;if(i>=0)bins[i]++;});
  histograma('grafTcl',bins,lo,larg,'#6a1b9a',
    n===1?'Valores individuais da população':'Média de '+n+' valores');
  const m=media(medias),dp=dpAmostra(medias);
  const ord=[...medias].sort((a,b)=>a-b);
  const med=(ord[499]+ord[500])/2;
  const fb=document.getElementById('fbTcl');
  fb.style.display='block';
  if(n===1){
    fb.className='feedback nao';
    fb.innerHTML='<strong>Esta é a população crua, com n igual a 1.</strong> Repare na forma: pico espremido perto do zero e uma cauda comprida para a direita. Média igual a '+
      m.toFixed(2)+' e mediana igual a '+med.toFixed(2)+
      ', bem distantes uma da outra, que é a assinatura da assimetria positiva. Nenhum teste que pressupõe normalidade funcionaria bem aqui. Agora suba o controle devagar.';
  }else{
    fb.className='feedback ok';
    fb.innerHTML='<strong>Cada ponto do gráfico agora é uma média de '+n+' valores.</strong> A população continua torta, ninguém a consertou, e ainda assim a distribuição das médias ficou mais simétrica e mais estreita. Média igual a '+
      m.toFixed(2)+', mediana igual a '+med.toFixed(2)+
      ' e desvio padrão das médias igual a '+dp.toFixed(2)+
      '. É o teorema central do limite trabalhando, e é ele que sustenta os testes clássicos das próximas semanas. Repare também que a largura encolhe conforme o n cresce, na mesma raiz quadrada da Semana 3.';
  }
}
