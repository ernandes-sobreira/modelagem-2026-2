      const x=px(i),y=py(R.mij[i*b+j]);
      i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    }
    ctx.stroke();
    for(let i=0;i<a;i++){
      ctx.fillStyle=cores[j];
