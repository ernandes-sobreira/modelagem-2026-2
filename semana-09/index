<script>
function normalR(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function media(a){return a.reduce(function(x,y){return x+y;},0)/a.length;}
function logGama(x){
  const c=[76.18009172947146,-86.50532032941677,24.01409824083091,
           -1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];
  let y=x,tmp=x+5.5;
  tmp-=(x+0.5)*Math.log(tmp);
  let ser=1.000000000190015;
  for(let j=0;j<6;j++)ser+=c[j]/++y;
  return -tmp+Math.log(2.5066282746310005*ser/x);
}
function betacf(a,b,x){
  const MAXIT=250,EPS=3e-14,FPMIN=1e-300;
  let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;
  if(Math.abs(d)<FPMIN)d=FPMIN;
  d=1/d;let h=d;
  for(let m=1;m<=MAXIT;m++){
    const m2=2*m;
    let aa=m*(b-m)*x/((qam+m2)*(a+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;h*=d*c;
    aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;
    const del=d*c;h*=del;
    if(Math.abs(del-1)<EPS)break;
  }
  return h;
}
function betai(a,b,x){
  if(x<=0)return 0;if(x>=1)return 1;
  const bt=Math.exp(logGama(a+b)-logGama(a)-logGama(b)+a*Math.log(x)+b*Math.log(1-x));
  return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b;
}
function pF(F,gl1,gl2){
  if(F<=0||!isFinite(F))return 1;
  return betai(gl2/2,gl1/2,gl2/(gl2+gl1*F));
}
function fmtP(p){return p<0.001?'menor que 0,001':'igual a '+p.toFixed(4).replace('.',',');}
function fmtPc(p){return p<0.001?'&lt;0,001':p.toFixed(4).replace('.',',');}
function lerCaixa(id){
  return document.getElementById(id).value.split(/[\n,;\t ]+/)
    .map(function(s){return s.trim().replace(',','.');}).filter(function(s){return s!=='';})
    .map(Number).filter(function(x){return !isNaN(x);});
}

/* ANOVA de duas vias balanceada, a niveis x b niveis x n replicas */
function calcAnova2(cel,a,b,n){
  const todos=[];
  cel.forEach(function(c){c.forEach(function(v){todos.push(v);});});
  const N=todos.length,mg=media(todos);
  const mij=cel.map(media);
  const mA=[],mB=[];
  for(let i=0;i<a;i++){
    let s=0;for(let j=0;j<b;j++)s+=mij[i*b+j];
    mA.push(s/b);
  }
  for(let j=0;j<b;j++){
    let s=0;for(let i=0;i<a;i++)s+=mij[i*b+j];
    mB.push(s/a);
  }
  let sqA=0,sqB=0,sqAB=0,sqR=0;
  for(let i=0;i<a;i++)sqA+=n*b*Math.pow(mA[i]-mg,2);
  for(let j=0;j<b;j++)sqB+=n*a*Math.pow(mB[j]-mg,2);
  for(let i=0;i<a;i++)for(let j=0;j<b;j++)
    sqAB+=n*Math.pow(mij[i*b+j]-mA[i]-mB[j]+mg,2);
  cel.forEach(function(c,k){
    const m=mij[k];
    c.forEach(function(v){sqR+=Math.pow(v-m,2);});
  });
  const glA=a-1,glB=b-1,glAB=(a-1)*(b-1),glR=a*b*(n-1);
  const qmA=sqA/glA,qmB=sqB/glB,qmAB=sqAB/glAB,qmR=sqR/glR;
  const sqT=sqA+sqB+sqAB+sqR;
  return {mij:mij,mA:mA,mB:mB,mg:mg,N:N,
    sqA:sqA,sqB:sqB,sqAB:sqAB,sqR:sqR,sqT:sqT,
    glA:glA,glB:glB,glAB:glAB,glR:glR,
    qmA:qmA,qmB:qmB,qmAB:qmAB,qmR:qmR,
    fA:qmA/qmR,fB:qmB/qmR,fAB:qmAB/qmR,
    pA:pF(qmA/qmR,glA,glR),pB:pF(qmB/qmR,glB,glR),pAB:pF(qmAB/qmR,glAB,glR),
    etaA:sqA/sqT,etaB:sqB/sqT,etaAB:sqAB/sqT};
}

