<script>
function normalR(m,s){
  let u=0,v=0;
  while(u===0)u=Math.random();
  while(v===0)v=Math.random();
  return m+s*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function media(a){return a.reduce(function(x,y){return x+y;},0)/a.length;}
function varAm(a){const m=media(a);return a.reduce(function(x,y){return x+(y-m)*(y-m);},0)/(a.length-1);}
function logGama(x){
  const c=[76.18009172947146,-86.50532032941677,24.01409824083091,
           -1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];
  let y=x,tmp=x+5.5;
  tmp-=(x+0.5)*Math.log(tmp);
  let ser=1.000000000190015;
  for(let j=0;j<6;j++)ser+=c[j]/++y;
  return -tmp+Math.log(2.5066282746310005*ser/x);
}
function betacf(a,b,x){
  const MAXIT=250,EPS=3e-14,FPMIN=1e-300;
  let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;
  if(Math.abs(d)<FPMIN)d=FPMIN;
  d=1/d;let h=d;
  for(let m=1;m<=MAXIT;m++){
    const m2=2*m;
    let aa=m*(b-m)*x/((qam+m2)*(a+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;h*=d*c;
    aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));
    d=1+aa*d;if(Math.abs(d)<FPMIN)d=FPMIN;
    c=1+aa/c;if(Math.abs(c)<FPMIN)c=FPMIN;
    d=1/d;
    const del=d*c;h*=del;
    if(Math.abs(del-1)<EPS)break;
  }
  return h;
}
function betai(a,b,x){
  if(x<=0)return 0;if(x>=1)return 1;
  const bt=Math.exp(logGama(a+b)-logGama(a)-logGama(b)+a*Math.log(x)+b*Math.log(1-x));
  return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b;
}
function pT(t,gl){return betai(gl/2,0.5,gl/(gl+t*t));}
function pF(F,gl1,gl2){
  if(F<=0)return 1;
  return betai(gl2/2,gl1/2,gl2/(gl2+gl1*F));
}
function tCritico(gl){
  let t=0.5;
  while(t<12&&pT(t,gl)>0.05)t+=0.002;
  return t;
}
function tCriticoAlfa(gl,alfa){
  let t=0.5;
  while(t<20&&pT(t,gl)>alfa)t+=0.002;
  return t;
}
function fmtP(p){return p<0.001?'menor que 0,001':'igual a '+p.toFixed(4).replace('.',',');}
function lerCaixa(id){
  return document.getElementById(id).value.split(/[\n,;\t ]+/)
    .map(function(s){return s.trim().replace(',','.');}).filter(function(s){return s!=='';})
    .map(Number).filter(function(x){return !isNaN(x);});
}

/* ATIVIDADE 1 */
document.getElementById('kg').addEventListener('input',function(e){
  document.getElementById('kLab').textContent=e.target.value;});
document.getElementById('nk').addEventListener('input',function(e){
  document.getElementById('nkLab').textContent=e.target.value;});
function multiplas(){
  const k=parseInt(document.getElementById('kg').value);
  const n=parseInt(document.getElementById('nk').value);
  const comp=k*(k-1)/2;
  let comFalso=0,anovaFalso=0;
  for(let e=0;e<1000;e++){
    const grupos=[];
    for(let g=0;g<k;g++){
      const a=[];for(let i=0;i<n;i++)a.push(normalR(50,10));
      grupos.push(a);
    }
    let achou=false;
    for(let i=0;i<k&&!achou;i++)for(let j=i+1;j<k;j++){
      const A=grupos[i],B=grupos[j];
      const sp2=((n-1)*varAm(A)+(n-1)*varAm(B))/(2*n-2);
      const t=(media(A)-media(B))/Math.sqrt(sp2*(2/n));
      if(pT(t,2*n-2)<0.05){achou=true;break;}
    }
    if(achou)comFalso++;
    const todos=grupos.flat(),mg=media(todos);
    let sqE=0,sqD=0;
    grupos.forEach(function(g){
      const m=media(g);
      sqE+=n*(m-mg)*(m-mg);
      g.forEach(function(v){sqD+=(v-m)*(v-m);});
    });
    const F=(sqE/(k-1))/(sqD/(k*n-k));
    if(pF(F,k-1,k*n-k)<0.05)anovaFalso++;
  }
  const teo=(1-Math.pow(0.95,comp))*100;
  document.getElementById('mComp').textContent=comp;
  document.getElementById('mTeo').textContent=teo.toFixed(1)+'%';
  document.getElementById('mObs').textContent=(comFalso/10).toFixed(1)+'%';
  document.getElementById('mAnova').textContent=(anovaFalso/10).toFixed(1)+'%';
  const fb=document.getElementById('fbMult');
  fb.className='feedback nao';
  fb.innerHTML='<strong>Nenhum dos '+k+' grupos difere de verdade.</strong> Todos vieram da mesma população, com a mesma média. '+
    'Ainda assim, em '+(comFalso/10).toFixed(1)+' por cento dos mil estudos pelo menos uma das '+comp+
    ' comparações par a par deu significativa. A previsão teórica era '+teo.toFixed(1)+' por cento, e a simulação confirmou. '+
    '<br><br><strong>Agora compare com a última caixa.</strong> A ANOVA, aplicada aos mesmos dados, produziu falso positivo em apenas '+
    (anovaFalso/10).toFixed(1)+' por cento dos estudos, que é o 5 por cento combinado desde o início. Uma pergunta, um teste, um risco. '+
    'Aumente o número de grupos e veja a primeira porcentagem disparar enquanto a segunda fica parada.';
}
