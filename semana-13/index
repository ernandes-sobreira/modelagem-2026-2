let idx=0,restante=blocos[0].s,rodando=false,timer=null,estourou=false;
function fmtT(s){
  const neg=s<0;const a=Math.abs(s);
  const m=Math.floor(a/60),ss=a%60;
  return (neg?'-':'')+m+':'+(ss<10?'0':'')+ss;
}
function pintarCrono(){
  document.getElementById('cTempo').textContent=fmtT(restante);
  document.getElementById('cTempo').className='crono-tempo'+(restante<0?' estourou':'');
  document.getElementById('cBloco').textContent=blocos[idx].n;
  document.getElementById('cProx').textContent=
