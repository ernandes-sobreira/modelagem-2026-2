function montarInteracao(){
  const ea=parseInt(document.getElementById('ea').value);
  const eb=parseInt(document.getElementById('eb').value);
  const ei=parseInt(document.getElementById('ei').value);
  const ed=parseInt(document.getElementById('ed').value);
  const n=6,a=3,b=2;
  const cel=[];
  const alvo=[];
  for(let i=0;i<a;i++)for(let j=0;j<b;j++){
    const base=8+ea*(a-1-i)/(a-1)*2+eb*(1-j);
    const extra=ei*((i===1?1:0))*(j===0?1:-1);
    const mu=base+extra;
    alvo.push(mu);
    const c=[];for(let r=0;r<n;r++)c.push(normalR(mu,ed));
    cel.push(c);
  }
  const R=calcAnova2(cel,a,b,n);
  const cv=document.getElementById('grafInt'),ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mEs=58,mD=26,mT=24,mB=54;
  ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
  const vals=R.mij.slice();
  const lo=Math.min.apply(null,vals)-3,hi=Math.max.apply(null,vals)+3;
  const px=function(i){return mEs+(i+0.5)*(W-mEs-mD)/a;};
  const py=function(v){return H-mB-((v-lo)/(hi-lo||1))*(H-mT-mB);};
